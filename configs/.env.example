# Server Configuration
PORT=8080

# Kafka Configuration
KAFKA_HOSTS=localhost:9092
KAFKA_TOPIC=cdc-events
KAFKA_CONSUMER_GROUP_ID=evb-consumer-group
KAFKA_MAX_RETRY=3
KAFKA_RETRY_FREQUENCY=500

# Kafka SASL (Optional)
# KAFKA_SASL_USER=your-username
# KAFKA_SASL_PASS=your-password

# Queue Configuration
QUEUE_SIZE=1000

# Sink Configuration Path
SINK_CONFIG_PATH=config.yaml

# Stitching Rules (JSON format)
# Format: {"operation": "comma,separated,tables"}
RULESET_MAP={"c":"users,orders","u":"users,orders","d":"users"}

# Azure Blob Storage (Optional)
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string
